{
  "name": "BriefCraft ChatGPT App",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "BriefCraft MCP",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "nohup npm start > /tmp/briefcraft-app.log 2>&1 &"
}
