[Unit]
Description=OSMINOG Mouse bounded SearXNG search
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/osminog/mouse-search/current
ExecStart=/opt/osminog/mouse-search/current/venv/bin/python -I -B /opt/osminog/mouse-search/current/server.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=512M
MemorySwapMax=0
CPUQuota=25%
TasksMax=64
LimitNOFILE=192
LimitFSIZE=33554432
LimitCORE=0
Nice=10
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
