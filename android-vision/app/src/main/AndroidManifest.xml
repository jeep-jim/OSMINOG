 <application android:theme="@style/AppTheme" android:label="OSMINOG" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:allowBackup="false" android:enableOnBackInvokedCallback="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
