{
  "name": "osminog-desktop",
  "version": "4.0.2",
  "private": true,
  "description": "OSMINOG local browser preview",
  "author": "OSMINOG",
  "main": "main.cjs",
  "scripts": {
    "prepare:board": "node prepare.cjs",
    "start": "npm run prepare:board && electron .",
    "test": "node --test contracts.test.cjs trust.test.cjs updates.test.cjs browser-state.test.cjs network.test.cjs page-preload.test.cjs provider-clean.test.cjs control.test.cjs media.test.cjs direct-chat.test.cjs startup.test.cjs context-menu.test.cjs session-transport.test.cjs agent-tools.test.cjs original-actions.test.cjs file-clipboard.test.cjs office.test.cjs browser-context.test.cjs",
    "build:win": "npm run prepare:board && electron-builder --win nsis --x64 --publish never",
    "postinstall": "node node_modules/electron/install.js",
    "pretest": "node prepare.cjs"
  },
  "devDependencies": {
    "electron": "44.5.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.osminog.desktop.preview",
    "productName": "OSMINOG Preview",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "storage.cjs",
      "board/**/*",
      "package.json",
      "browser.cjs",
      "windows-identity.cjs",
      "browser-smoke.cjs",
      "trust.cjs",
      "updates.cjs",
      "provider.cjs",
      "protocol.cjs",
      "provider-smoke.cjs",
      "update-smoke.cjs",
      "shell-smoke.cjs",
      "network.cjs",
      "page-context.cjs",
      "page-preload.cjs",
      "release-notes.cjs",
      "control.cjs",
      "control-smoke.cjs",
      "file-save.cjs",
      "files-smoke.cjs",
      "icons/**/*",
      "media.cjs",
      "control-plan.cjs",
      "direct-chat.cjs",
      "direct-smoke.cjs",
      "startup.cjs",
      "context-menu.cjs",
      "session-transport.cjs",
      "agent-tools.cjs",
      "session-smoke.cjs",
      "original-actions.cjs",
      "file-clipboard.cjs",
      "office.cjs",
      "browser-context.cjs",
      "files-live-smoke.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/osminog-eye.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "icons/osminog-eye.ico",
      "uninstallerIcon": "icons/osminog-eye.ico",
      "installerHeaderIcon": "icons/osminog-eye.ico"
    },
    "artifactName": "OSMINOG-Preview-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/jeep-jim/OSMINOG-Releases/releases/download/windows-preview/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
