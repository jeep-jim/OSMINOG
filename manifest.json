{
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Open OSMINOG"
  },
  "background": {
    "service_worker": "background-service.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "default_locale": "en",
  "description": "Fast local clipboard collection, infinite desks, search and connected AI chat.",
  "host_permissions": [
    "https://api.github.com/*",
    "https://uploads.github.com/*",
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "manifest_version": 3,
  "minimum_chrome_version": "148",
  "name": "OSMINOG",
  "optional_host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*",
    "https://chat.deepseek.com/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://deepseek.com/*",
    "https://gemini.google.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://google.com/*",
    "https://www.deepseek.com/*",
    "https://www.google.com/*",
    "https://alice.yandex.ru/*",
    "https://api.github.com/*",
    "https://uploads.github.com/*",
    "https://github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "permissions": [
    "alarms",
    "activeTab",
    "clipboardWrite",
    "unlimitedStorage",
    "scripting",
    "storage",
    "tabs",
    "clipboardRead",
    "offscreen"
  ],
  "short_name": "OSMINOG",
  "version": "4.0.38",
  "version_name": "4.0.38"
}
